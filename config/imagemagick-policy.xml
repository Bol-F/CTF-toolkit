<?xml version="1.0" encoding="UTF-8"?>
<!-- Raster inspection only. https://imagemagick.org/security-policy/ -->
<policymap>
  <policy domain="resource" name="memory" value="128MiB"/>
  <policy domain="resource" name="map" value="128MiB"/>
  <policy domain="resource" name="disk" value="0"/>
  <policy domain="resource" name="area" value="32MP"/>
  <policy domain="resource" name="width" value="20KP"/>
  <policy domain="resource" name="height" value="20KP"/>
  <policy domain="resource" name="list-length" value="16"/>
  <policy domain="resource" name="time" value="15"/>
  <policy domain="resource" name="thread" value="1"/>
  <policy domain="delegate" rights="none" pattern="*"/>
  <policy domain="filter" rights="none" pattern="*"/>
  <policy domain="path" rights="none" pattern="@*"/>
  <policy domain="coder" rights="none" pattern="*"/>
  <policy domain="coder" rights="read" pattern="{PNG,JPEG,GIF,BMP,TIFF,WEBP}"/>
</policymap>
