#!/bin/sh
export MALLOC_ARENA_MAX=2
exec java -Xms16m -Xmx128m -XX:+UseSerialGC -XX:ActiveProcessorCount=1 -XX:ReservedCodeCacheSize=16m -XX:MaxMetaspaceSize=48m -XX:CompressedClassSpaceSize=16m -XX:MaxDirectMemorySize=16m -Xss256k -Djava.awt.headless=true -Duser.home="${HOME:-/tmp}" -Djava.io.tmpdir="${TMPDIR:-/tmp}" -jar /opt/openstego/openstego.jar "$@"
